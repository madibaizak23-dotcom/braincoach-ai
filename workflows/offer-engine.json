        "query": "={{\n`\nSELECT \n  c.telegram_user_id,\n  c.first_name,\n  c.username,\n  c.current_keyword,\n  COALESCE(\n    (SELECT json_agg(json_build_object('signal_type', signal_type, 'meaning', meaning)) \n     FROM memory_facts \n     WHERE telegram_user_id = c.telegram_user_id),\n    '[]'::json\n  ) as memory_facts\nFROM clients c\nWHERE c.telegram_user_id = ${$json.telegram_user_id};\n`\n}}",
