        "query": "={{\n`\nINSERT INTO offers_sent (telegram_user_id, offer_id, keyword, offer_message, status)\nVALUES (\n  ${$node[\"Postgres - Get Dossier\"].json[\"telegram_user_id\"]},\n  '${$node[\"GoogleSheets - offers_master\"].json[\"offer_id\"] || \"offer_default\"}',\n  '${$node[\"Postgres - Get Dossier\"].json[\"current_keyword\"]}',\n  '${$node[\"OpenAI - Custom Offer Generator\"].json[\"message\"][\"content\"].replace(/'/g, \"''\")}',\n  'pending'\n)\nON CONFLICT (telegram_user_id, offer_id) \nDO UPDATE SET offer_message = EXCLUDED.offer_message, status = 'pending';\n\nINSERT INTO events (\n  telegram_user_id,\n  event_name,\n  event_category,\n  keyword,\n  model_used\n)\nVALUES (\n  ${$node[\"Postgres - Get Dossier\"].json[\"telegram_user_id\"]},\n  'offer.sent',\n  'offer',\n  '${$node[\"Postgres - Get Dossier\"].json[\"current_keyword\"]}',\n  'gpt-5.4-mini'\n);\n`\n}}",
        "additionalFields": {}
