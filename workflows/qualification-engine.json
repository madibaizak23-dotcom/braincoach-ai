          "={{$json[\"message\"][\"from\"][\"id\"]}}",
          "={{$node[\"Postgres - Find Client\"].json[0] && $node[\"Postgres - Find Client\"].json[0].current_stage || null}}",
          "={{$node[\"Postgres - Update Client\"].json[0] && $node[\"Postgres - Update Client\"].json[0].current_stage || null}}",
          "={{JSON.parse($node[\"OpenAI - Intake Classifier\"].json.choices[0].message.content).keyword}}",
          "=OpenAI:qualification",
          "={{JSON.stringify({classifier: JSON.parse($node[\"OpenAI - Intake Classifier\"].json.choices[0].message.content), emotional: JSON.parse($node[\"OpenAI - Emotional Reflection\"].json.choices[0].message.content), qualification: JSON.parse($node[\"OpenAI - Qualification Engine\"].json.choices[0].message.content)})}}"
