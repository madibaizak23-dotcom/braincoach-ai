        "query": "={{\n`\nSELECT \n  c.telegram_user_id,\n  c.first_name,\n  c.username,\n  c.current_stage,\n  c.current_keyword,\n  c.last_message_at,\n  c.last_nudge_sent_at,\n  cs.sub_stage,\n  cs.pattern_type\nFROM clients c\nLEFT JOIN conversation_state cs ON c.telegram_user_id = cs.telegram_user_id\nWHERE c.allow_reminders = true\n  AND c.last_message_at < NOW() - INTERVAL '24 hours'\n  AND (c.last_nudge_sent_at IS NULL OR c.last_nudge_sent_at < NOW() - INTERVAL '24 hours')\n  AND c.current_stage IN ('q1', 'q2', 'q3', 'offer', 'offer_transition');\n`\n}}",
