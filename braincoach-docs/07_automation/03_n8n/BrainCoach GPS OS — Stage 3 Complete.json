      "parameters": {
        "jsCode": "const entries = $input.all();\n\nif (entries.length === 0) {\n  return [{\n    json: {\n      reply: \"📚 У вас пока нет сохранённых записей\"\n    }\n  }];\n}\n\nconst lines = entries.map(entry => {\n  const icon =\n    entry.json.entry_type === 'observation' ? '📌' :\n    entry.json.entry_type === 'insight' ? '💡' :\n    '📝';\n\n  return `${icon} ${entry.json.content}`;\n});\n\nreturn [{\n  json: {\n    reply:\n      \"📚 Последние записи\\n\\n\" +\n      lines.join(\"\\n\\n\")\n  }\n}];"
      },
