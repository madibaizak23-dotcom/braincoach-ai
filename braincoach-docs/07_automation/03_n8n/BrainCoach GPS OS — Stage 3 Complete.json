        "query": "WITH upserted_client AS (\nINSERT INTO clients (\ntelegram_user_id,\nfirst_name,\nusername,\ncurrent_stage,\nlast_message_at,\nupdated_at\n)\nVALUES (\n'{{ $node[\"TG_Trigger\"].json.message.from.id }}',\n'{{ ($node[\"TG_Trigger\"].json.message.from.first_name || \"\").replace(/'/g, \"''\") }}',\n'{{ ($node[\"TG_Trigger\"].json.message.from.username || \"\").replace(/'/g, \"''\") }}',\n'tracking',\nNOW(),\nNOW()\n)\nON CONFLICT (telegram_user_id)\nDO UPDATE SET\nusername = EXCLUDED.username,\nlast_message_at = NOW(),\nupdated_at = NOW()\nRETURNING *\n),\n\nensured_state AS (\nINSERT INTO conversation_state (\ntelegram_user_id,\nsub_stage,\npattern_type,\nqualification_signals\n)\nVALUES (\n'{{ $node[\"TG_Trigger\"].json.message.from.id }}',\n'capture',\nNULL,\n'{}'::jsonb\n)\nON CONFLICT (telegram_user_id)\nDO UPDATE SET\nupdated_at = NOW()\nRETURNING *\n)\n\nSELECT\nuc.current_stage,\nuc.allow_reminders,\nes.sub_stage,\nes.pattern_type,\nes.qualification_signals\nFROM upserted_client uc\nJOIN ensured_state es\nON es.telegram_user_id = uc.telegram_user_id;\n",
