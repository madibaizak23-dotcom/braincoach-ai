        "query": "WITH upserted_client AS (\n  INSERT INTO clients (\n    telegram_user_id,\n    first_name,\n    username,\n    current_stage,\n    last_message_at,\n    updated_at\n  )\n  VALUES (\n    '{{ $node[\"Telegram Trigger\"].json.message.from.id }}',\n    '{{ ($node[\"Telegram Trigger\"].json.message.from.first_name || \"\").replace(/'/g, \"''\") }}',\n    '{{ ($node[\"Telegram Trigger\"].json.message.from.username || \"\").replace(/'/g, \"''\") }}',\n    'new_lead',\n    NOW(),\n    NOW()\n  )\n  ON CONFLICT (telegram_user_id)\n  DO UPDATE SET\n    username = EXCLUDED.username,\n    last_message_at = NOW(),\n    updated_at = NOW()\n  RETURNING *\n), \nensured_state AS (\n  INSERT INTO conversation_state (\n    telegram_user_id,\n    sub_stage,\n    pattern_type,\n    qualification_signals\n  )\n  VALUES (\n    '{{ $node[\"Telegram Trigger\"].json.message.from.id }}',\n    'q_surface',\n    NULL,\n    '{}'::jsonb\n  )\n  ON CONFLICT (telegram_user_id)\n  DO UPDATE SET updated_at = NOW()\n  RETURNING *\n)\nSELECT\n  uc.current_stage,\n  uc.allow_reminders,\n  es.sub_stage,\n  es.pattern_type,\n  es.qualification_signals\nFROM upserted_client uc\nJOIN ensured_state es ON es.telegram_user_id = uc.telegram_user_id;",
        "additionalFields": {}
