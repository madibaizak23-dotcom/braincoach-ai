    {
      "parameters": {
        "jsCode": "const files = $json.modified_files || [];\n\nreturn files.map(path => {\n\n  let object_type = 'unknown';\n\n  // Core Knowledge OS\n\n  if (path.includes('00_canon'))\n    object_type = 'canon';\n\n  else if (path.includes('01_foundation'))\n    object_type = 'foundation';\n\n  else if (path.includes('02_ontology'))\n    object_type = 'ontology';\n\n  else if (path.includes('03_knowledge/01'))\n    object_type = 'research';\n\n  else if (path.includes('03_knowledge/02'))\n    object_type = 'intelligence';\n\n  else if (path.includes('03_knowledge/03'))\n    object_type = 'registry';\n\n  else if (path.includes('03_knowledge/04'))\n    object_type = 'decision';\n\n  else if (path.includes('03_knowledge'))\n    object_type = 'knowledge';\n\n  // Domains\n\n  else if (path.includes('04_domain'))\n    object_type = 'domain';\n\n  // Operations\n\n  else if (path.includes('05_operations'))\n    object_type = 'operations';\n\n  // Analytics\n\n  else if (path.includes('06_analytics'))\n    object_type = 'analytics';\n\n  // Automation\n\n  else if (path.includes('07_automation'))\n    object_type = 'automation';\n\n  // Repository service folders\n\n  else if (path.includes('/active/'))\n    object_type = 'active';\n\n  else if (path.includes('/archive/'))\n    object_type = 'archive';\n\n  else if (path.includes('/architecture/'))\n    object_type = 'architecture';\n\n  const filename = path\n    .split('/')\n    .pop()\n    .replace('.md', '')\n    .replace('.txt', '')\n    .replace('.pdf', '');\n\n  return {\n    json: {\n      object_name: filename,\n      object_type,\n      object_path: path,\n      status: 'active',\n      discovered_at: new Date().toISOString()\n    }\n  };\n\n});"
      },
