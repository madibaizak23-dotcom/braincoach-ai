{
  "name": "knowledge_registry_sync_v1.",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst headers = $input.first().json.headers;\n\n// собираем ВСЕ файлы из ВСЕХ коммитов push\n\nconst modified = [];\n\nfor (const commit of (body.commits || [])) {\n\n  modified.push(...(commit.modified || []));\n  modified.push(...(commit.added || []));\n  modified.push(...(commit.removed || []));\n\n}\n\n// удаляем дубликаты\n\nconst uniqueModified = [...new Set(modified)];\n\nlet object_type = 'unknown';\n\nif (uniqueModified.some(f => f.includes('00_canon'))) {\n  object_type = 'canon';\n}\nelse if (uniqueModified.some(f => f.includes('01_foundation'))) {\n  object_type = 'foundation';\n}\nelse if (uniqueModified.some(f => f.includes('02_ontology'))) {\n  object_type = 'ontology';\n}\nelse if (uniqueModified.some(f => f.includes('03_knowledge'))) {\n  object_type = 'knowledge';\n}\nelse if (uniqueModified.some(f => f.includes('04_domain'))) {\n  object_type = 'domain';\n}\nelse if (uniqueModified.some(f => f.includes('05_operations'))) {\n  object_type = 'operations';\n}\nelse if (uniqueModified.some(f => f.includes('06_analytics'))) {\n  object_type = 'analytics';\n}\nelse if (uniqueModified.some(f => f.includes('07_automation'))) {\n  object_type = 'automation';\n}\n\nreturn [{\n  json: {\n\n    event: headers['x-github-event'],\n\n    repository: body.repository?.name,\n\n    branch: body.ref?.replace('refs/heads/', ''),\n\n    commit_id: body.after,\n\n    commit_message: body.head_commit?.message,\n\n    timestamp: body.head_commit?.timestamp,\n\n    object_type,\n\n    modified_files: uniqueModified,\n\n    files_count: uniqueModified.length\n\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -528,
        -112
      ],
